---
import Layout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;

const formatDate = (d: Date) =>
  d.toLocaleDateString('zh-CN', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

const readingTime = Math.max(1, Math.ceil(post.body.length / 500));
---

<Layout title={title} description={description}>
  <article>
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {
          updatedDate && updatedDate > pubDate && (
            <span>
              · 更新于 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
        <span>· 约 {readingTime} 分钟阅读</span>
      </div>
      {
        tags.length > 0 && (
          <ul class="tag-list">
            {tags.map((tag) => (
              <li>
                <a href={`/tags/${tag}/`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</Layout>
